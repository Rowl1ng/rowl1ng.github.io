<div class="col">
  <a href="{% if thesis.redirect %}{{ thesis.redirect }}{% else %}{{ thesis.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="card-body">
        <h2 class="card-title">{{ thesis.title }}</h2>
        <h6 class="card-subtitle mb-2 text-muted">
          {{ thesis.student }} · {{ thesis.year }}
        </h6>
        <p class="card-text">{{ thesis.description }}</p>
      </div>
    </div>
  </a>
</div>
